{"id":"105-22","year":105,"num":22,"type":"choice","img":"01_題目圖片/105/105_Q22.png","answer":"A","codes":["S-9-7","S-9-6"],"perf":["s-IV-14"],"book":"B5","chapter":"第2章 圓","topic":"找圓心的兩種作法","difficulty":"難",
