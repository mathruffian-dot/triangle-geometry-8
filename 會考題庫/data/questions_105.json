{"id":"105-20","year":105,"num":20,"type":"choice","img":"01_題目圖片/105/105_Q20.png","answer":"A","codes":["S-8-6"],"perf":["s-IV-7"],"book":"B3","chapter":"第2章 平方根與畢氏定理","topic":"畢氏定理（雙弧）","difficulty":"中",
