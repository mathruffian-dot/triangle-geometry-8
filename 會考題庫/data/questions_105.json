 "steps":["兩段弧給出 AF=5、CE=17/3","△CBE：BE=√(CE²−BC²)=8/3","AE=17/3−8/3=3 → EF=5−3=2"]},
{"id":"105-21","year":105,"num":21,"type":"choice","img":"01_題目圖片/105/105_Q21.png","answer":"D","codes":["F-9-2"],"perf":["f-IV-2","f-IV-3"],"book":"B6","chapter":"第1章 二次函數","topic":"由頂點與根判斷函數值","difficulty":"中",
