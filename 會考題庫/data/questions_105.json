{"id":"105-18","year":105,"num":18,"type":"choice","img":"01_題目圖片/105/105_Q18.png","answer":"D","codes":["S-9-13"],"perf":["s-IV-16"],"book":"B6","chapter":"第3章 立體圖形","topic":"圓柱水量守恆","difficulty":"中",
