{"id":"105-17","year":105,"num":17,"type":"choice","img":"01_題目圖片/105/105_Q17.png","answer":"B","codes":["N-7-2"],"perf":["n-IV-1"],"book":"B1","chapter":"第2章 分數的運算","topic":"最大公因數的結構推理","difficulty":"難",
