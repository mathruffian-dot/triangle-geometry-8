{"id":"109-16","year":109,"num":16,"type":"choice","img":"01_題目圖片/109/109_Q16.png","answer":"C","codes":["N-7-9","A-7-3"],"perf":["n-IV-4"],"book":"B2","chapter":"第3章 比與比例式","topic":"比例應用（月餅）","difficulty":"易",
