{"id":"109-12","year":109,"num":12,"type":"choice","img":"01_題目圖片/109/109_Q12.png","answer":"C","codes":["S-9-7"],"perf":["s-IV-14"],"book":"B5","chapter":"第2章 圓","topic":"圓的定義（動點軌跡）","difficulty":"易",
