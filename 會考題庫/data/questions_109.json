{"id":"109-10","year":109,"num":10,"type":"choice","img":"01_題目圖片/109/109_Q10.png","answer":"D","codes":["A-8-7"],"perf":["a-IV-6"],"book":"B3","chapter":"第4章 一元二次方程式","topic":"平方根法","difficulty":"易",
