{"id":"109-13","year":109,"num":13,"type":"choice","img":"01_題目圖片/109/109_Q13.png","answer":"B","codes":["D-7-2","D-7-1"],"perf":["d-IV-1"],"book":"B2","chapter":"第5章 統計","topic":"中位數（長條圖）","difficulty":"中",
