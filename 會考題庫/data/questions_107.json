{"id":"107-15","year":107,"num":15,"type":"choice","img":"01_題目圖片/107/107_Q15.png","answer":"D","codes":["S-9-13","S-7-2"],"perf":["s-IV-16"],"book":"B6","chapter":"第3章 立體圖形","topic":"直角柱展開圖判斷","difficulty":"難",
