{"id":"107-07","year":107,"num":7,"type":"choice","img":"01_題目圖片/107/107_Q07.png","answer":"A","codes":["N-8-1"],"perf":["n-IV-5"],"book":"B3","chapter":"第2章 平方根與畢氏定理","topic":"根式分配運算","difficulty":"中",
