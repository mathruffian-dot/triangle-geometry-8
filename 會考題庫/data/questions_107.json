{"id":"107-18","year":107,"num":18,"type":"choice","img":"01_題目圖片/107/107_Q18.png","answer":"D","codes":["S-8-2","S-8-8"],"perf":["s-IV-2"],"book":"B4","chapter":"第3章 三角形的基本性質","topic":"互補角的構造","difficulty":"難",
