{"id":"107-12","year":107,"num":12,"type":"choice","img":"01_題目圖片/107/107_Q12.png","answer":"B","codes":["N-7-5","A-7-1"],"perf":["n-IV-2","a-IV-1"],"book":"B1","chapter":"第1章 整數的運算","topic":"數線與符號表示","difficulty":"中",
