{"id":"111-02","year":111,"num":2,"type":"choice","img":"01_題目圖片/111/111_Q02.png","answer":"D","codes":["A-8-3"],"perf":["a-IV-5"],"book":"B3","chapter":"第1章 乘法公式與多項式","topic":"多項式除法（餘式）","difficulty":"易",
