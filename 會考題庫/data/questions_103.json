 "steps":["包廂：5400+99n","人數：540+240=780 元/人","5400+99n<780n → n≥8"]},
{"id":"103-23","year":103,"num":23,"type":"choice","img":"01_題目圖片/103/103_Q23.png","answer":"A","codes":["N-8-4","N-8-5"],"perf":["n-IV-7","n-IV-8"],"book":"B4","chapter":"第1章 數列與級數","topic":"等差數列與級數","difficulty":"中",
 "solution":"S₉=9a₅=54 → a₅=6。a₁+a₄+a₇=3a₄=36 → a₄=12。d=a₅−a₄=−6。選 (A)。",
 "steps":["九項和=9×中間項 → a₅=6","三項等距 → 和=3×中間項 a₄=12","公差=6−12=−6"],
