{"id":"103-15","year":103,"num":15,"type":"choice","img":"01_題目圖片/103/103_Q15.png","answer":"D","codes":["A-8-3"],"perf":["a-IV-5"],"book":"B3","chapter":"第1章 乘法公式與多項式","topic":"多項式除法（餘式次數）","difficulty":"中",
